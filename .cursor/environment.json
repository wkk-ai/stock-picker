{
  "name": "Stock Picker BR",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd backend && PYTHONPATH=. .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "web",
      "command": "cd web && npm run dev"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 3000 }
  ]
}
