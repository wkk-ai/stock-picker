{
  "name": "stock-picker",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "cd backend && .venv/bin/python -m app.bootstrap",
    "api": "cd backend && PYTHONPATH=. .venv/bin/uvicorn app.main:app --reload --port 8000",
    "web": "cd web && npm run dev",
    "dev": "echo 'Run npm run api and npm run web in two terminals'",
    "build": "npm install --prefix web && npm run build --prefix web",
    "start": "npm run start --prefix web"
  }
}
